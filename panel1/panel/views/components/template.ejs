<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= name %></title>
    <% if (logo == true) { %>
        <link rel="icon" href="/assets/logo.png" type="image/x-icon">
    <% } %>

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:ital,wght@0,100..800;1,100..800&family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

    <!-- Tailwind and Alpine -->
    <script src="https://cdn.tailwindcss.com?plugins=forms"></script>
    <script defer src="https://cdn.jsdelivr.net/npm/alpinejs@3.x.x/dist/cdn.min.js"></script>

    <style>
        :root {
            --header-bg: rgba(23, 23, 23, 0.85);
            --header-active: rgba(79, 70, 229, 0.3);
            --header-hover: rgba(255, 255, 255, 0.08);
            --header-text: rgba(255, 255, 255, 0.9);
            --header-text-active: rgba(255, 255, 255, 1);
        }

        body {
            font-family: 'Inter', sans-serif;
            color: rgba(255, 255, 255, 0.9);
            padding-top: 64px;
            background-color: #0f172a;
            position: relative;
            min-height: 100vh;
        }

        /* Animated GIF Background */
        .bg-animated {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            z-index: -1;
            object-fit: cover;
            opacity: 0.15;
            filter: blur(1px) contrast(1.2);
        }

        /* Glass header effect */
        .header {
            background: var(--header-bg);
            backdrop-filter: blur(16px);
            -webkit-backdrop-filter: blur(16px);
            border-bottom: 1px solid rgba(255, 255, 255, 0.08);
            box-shadow: 0 4px 30px rgba(0, 0, 0, 0.1);
            transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
            height: 64px;
            position: fixed;
            top: 0;
            left: 0;
            right: 0;
            z-index: 40;
            display: flex;
            align-items: center;
        }

        .header.collapsed {
            height: 48px;
            backdrop-filter: blur(12px);
        }

        .header.collapsed .header-text,
        .header.collapsed .header-footer-text,
        .header.collapsed .header-section-title {
            display: none;
        }

        .header.collapsed .header-link {
            justify-content: center;
            padding: 0.5rem;
        }

        .header.collapsed .header-icon {
            margin-right: 0;
            transform: scale(1.1);
        }

        /* Header link animations */
        .header-link {
            position: relative;
            color: var(--header-text);
            transition: all 0.3s ease;
            border-radius: 8px;
            overflow: hidden;
        }

        .header-link::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: linear-gradient(135deg, rgba(79, 70, 229, 0.1), transparent);
            opacity: 0;
            transition: opacity 0.3s ease;
        }

        .header-link:hover {
            background: var(--header-hover);
            color: var(--header-text-active);
            transform: translateY(-2px);
        }

        .header-link:hover::before {
            opacity: 1;
        }

        .header-link.active {
            background: var(--header-active);
            color: var(--header-text-active);
            font-weight: 500;
            box-shadow: 0 4px 6px rgba(79, 70, 229, 0.1);
        }

        .header-link.active::after {
            content: '';
            position: absolute;
            bottom: -12px;
            left: 50%;
            transform: translateX(-50%);
            width: 60%;
            height: 3px;
            background: #4f46e5;
            border-radius: 3px 3px 0 0;
            box-shadow: 0 0 8px rgba(79, 70, 229, 0.5);
        }

        /* Icon animations */
        .header-icon {
            width: 20px;
            height: 20px;
            display: flex;
            align-items: center;
            justify-content: center;
            transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
            margin-right: 8px;
        }

        .header-link:hover .header-icon {
            transform: scale(1.15) rotate(5deg);
            color: #818cf8;
        }

        .header-link.active .header-icon {
            color: #818cf8;
            transform: scale(1.1);
        }

        /* User dropdown */
        .user-dropdown {
            backdrop-filter: blur(16px);
            -webkit-backdrop-filter: blur(16px);
            background: rgba(23, 23, 23, 0.85);
            border: 1px solid rgba(255, 255, 255, 0.1);
            box-shadow: 0 8px 32px rgba(0, 0, 0, 0.2);
        }

        /* Loading animation */
        @keyframes loading {
            0% { width: 0%; opacity: 0.5; }
            50% { width: 80%; opacity: 1; }
            100% { width: 100%; opacity: 0; }
        }

        .loading-bar {
            position: fixed;
            top: 0;
            left: 0;
            height: 3px;
            background: linear-gradient(to right, #4f46e5, #818cf8, #c7d2fe);
            animation: loading 0.8s ease-out;
            z-index: 1000;
            box-shadow: 0 0 10px rgba(129, 140, 248, 0.7);
        }

        /* Scrollbar */
        ::-webkit-scrollbar {
            width: 8px;
        }

        ::-webkit-scrollbar-track {
            background: rgba(255, 255, 255, 0.05);
            border-radius: 4px;
        }

        ::-webkit-scrollbar-thumb {
            background: rgba(255, 255, 255, 0.15);
            border-radius: 4px;
            transition: background 0.3s;
        }

        ::-webkit-scrollbar-thumb:hover {
            background: rgba(255, 255, 255, 0.25);
        }

        /* Toggle button */
        .header-toggle {
            width: 28px;
            height: 28px;
            background: rgba(79, 70, 229, 0.2);
            border: 1px solid rgba(255, 255, 255, 0.1);
            border-radius: 8px;
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            z-index: 10;
            color: rgba(255, 255, 255, 0.8);
            transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
            margin-right: 12px;
        }

        .header-toggle:hover {
            background: rgba(79, 70, 229, 0.3);
            color: white;
            transform: translateY(-2px);
            box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
        }

        /* Navigation container */
        .header-nav {
            display: flex;
            align-items: center;
            height: 100%;
            padding: 0 20px;
            width: 100%;
            overflow-x: auto;
            scrollbar-width: none;
        }

        .header-nav::-webkit-scrollbar {
            display: none;
        }

        .header-items {
            display: flex;
            align-items: center;
            gap: 6px;
            height: 100%;
        }

        /* Logo/brand area */
        .header-brand {
            display: flex;
            align-items: center;
            margin-right: 24px;
            transition: all 0.3s ease;
        }

        .header-brand:hover {
            transform: scale(1.05);
        }

        .header-brand-logo {
            width: 32px;
            height: 32px;
            border-radius: 8px;
            background: linear-gradient(135deg, #4f46e5, #7c3aed);
            display: flex;
            align-items: center;
            justify-content: center;
            color: white;
            box-shadow: 0 4px 6px rgba(79, 70, 229, 0.2);
        }

        /* User area */
        .header-user {
            margin-left: auto;
            display: flex;
            align-items: center;
            gap: 16px;
        }

        .user-avatar {
            width: 36px;
            height: 36px;
            border-radius: 50%;
            background: linear-gradient(135deg, #4f46e5, #7c3aed);
            display: flex;
            align-items: center;
            justify-content: center;
            color: white;
            box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
            transition: all 0.3s ease;
            cursor: pointer;
        }

        .user-avatar:hover {
            transform: scale(1.1);
            box-shadow: 0 6px 12px rgba(79, 70, 229, 0.3);
        }

        .logout-btn {
            color: rgba(255, 255, 255, 0.7);
            transition: all 0.3s ease;
            cursor: pointer;
        }

        .logout-btn:hover {
            color: white;
            transform: translateX(2px);
        }

        /* Badges */
        .badge {
            font-size: 0.7rem;
            padding: 0.2rem 0.5rem;
            border-radius: 9999px;
            font-weight: 600;
            letter-spacing: 0.05em;
        }

        .badge-admin {
            background: rgba(239, 68, 68, 0.15);
            color: #ef4444;
        }

        .badge-indicator {
            background: rgba(79, 70, 229, 0.15);
            color: #818cf8;
        }
    </style>
</head>

<body x-data="{ 
        headerOpen: false, 
        currentPath: window.location.pathname,
        headerCollapsed: localStorage.getItem('headerCollapsed') === 'true' 
    }" 
    @keydown.escape="headerOpen = false"
    :class="headerCollapsed ? 'header-collapsed' : ''">

    <!-- Animated GIF Background -->
    <img src="https://media0.giphy.com/media/v1.Y2lkPTc5MGI3NjExZHpwcDQxcHI5MDk4anphaGVweWdsN3owbW00YnhzNzAzaWowa2VhYiZlcD12MV9pbnRlcm5hbF9naWZfYnlfaWQmY3Q9Zw/tXwHTbQuyjo1q/giphy.gif" 
         class="bg-animated" 
         alt="Animated background">

    <!-- Loading bar -->
    <div class="loading-bar"></div>

    <!-- Header -->
    <header class="header" 
            :class="{'collapsed': headerCollapsed}">
        <div class="header-nav">
            <!-- Toggle button -->
            <div class="header-toggle" 
                 @click="headerCollapsed = !headerCollapsed; localStorage.setItem('headerCollapsed', headerCollapsed)"
                 title="Toggle header size">
                <i class="fas text-sm" :class="headerCollapsed ? 'fa-chevron-down' : 'fa-chevron-up'"></i>
            </div>

            <!-- Brand/Logo -->
            <div class="header-brand">
                <div class="header-brand-logo">
                    <i class="fas fa-cube"></i>
                </div>
                <span class="ml-3 font-semibold text-white header-text">GFX</span>
            </div>

            <!-- Navigation -->
            <div class="header-items">
                <a href="../instances" class="header-link flex items-center px-4 py-2 text-sm"
                   :class="{'active': currentPath.includes('/instances')}">
                    <div class="header-icon">
                        <i class="fas fa-server"></i>
                    </div>
                    <span class="header-text">Servers</span>
                    <span class="badge badge-indicator ml-2 header-text">New</span>
                </a>

                <a href="../account" class="header-link flex items-center px-4 py-2 text-sm"
                   :class="{'active': currentPath.includes('/account')}">
                    <div class="header-icon">
                        <i class="fas fa-user-cog"></i>
                    </div>
                    <span class="header-text">Account</span>
                </a>

                <% if (req.user.admin === true) { %>
                <a href="/admin/overview" class="header-link flex items-center px-4 py-2 text-sm"
                   :class="{'active': currentPath.includes('/admin')}">
                    <div class="header-icon">
                        <i class="fas fa-shield-alt"></i>
                    </div>
                    <span class="header-text">Admin</span>
                    <span class="badge badge-admin ml-2 header-text">Admin</span>
                </a>
                <% } %>
            </div>

            <!-- User area -->
            <div class="header-user">
                <div class="flex items-center gap-3">
                    <div class="user-avatar">
                        <i class="fas fa-user"></i>
                    </div>
                    <div class="flex-1 min-w-0 header-text">
                        <p class="text-sm font-medium truncate"><%= user.username %></p>
                        <p class="text-xs text-gray-400 truncate">Administrator</p>
                    </div>
                </div>
                <button onclick="window.location.href='/login'" 
                        class="logout-btn header-text"
                        title="Logout">
                    <i class="fas fa-sign-out-alt text-lg"></i>
                </button>
            </div>
        </div>
    </header>

    <script>
        // Remove loading bar after animation
        setTimeout(() => {
            document.querySelector('.loading-bar').style.display = 'none';
        }, 800);

        // Track current path for active header links
        document.addEventListener('alpine:init', () => {
            Alpine.data('currentPath', () => ({
                currentPath: window.location.pathname
            }));
        });

        // Add parallax effect to background
        document.addEventListener('mousemove', (e) => {
            const bg = document.querySelector('.bg-animated');
            const x = e.clientX / window.innerWidth;
            const y = e.clientY / window.innerHeight;
            bg.style.transform = `translate(-${x * 20}px, -${y * 20}px)`;
        });
    </script>
</body>
</html>