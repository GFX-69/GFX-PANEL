<!DOCTYPE html>
<html lang="en" class="h-full">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>GFX PANEL - Login</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.2/gsap.min.js"></script>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700&display=swap" rel="stylesheet">
  <style>
    body {
      font-family: 'Inter', sans-serif;
      background: #0f172a;
      color: #f8fafc;
      overflow: hidden;
    }

    /* Background GIF */
    body::before {
      content: "";
      position: fixed;
      top: 0;
      left: 0;
      height: 100%;
      width: 100%;
      background: url("https://media4.giphy.com/media/v1.Y2lkPTc5MGI3NjExdnNzOWdqdWd2bTMzd21wazFtem50NDA1cXF1c2gwZ205NWlsZnc5dCZlcD12MV9pbnRlcm5hbF9naWZfYnlfaWQmY3Q9Zw/2PWBLDJ2KtB1X6o9vY/giphy.gif") no-repeat center center / cover;
      opacity: 0.15;
      z-index: -2;
    }

    .card {
      background: rgba(30, 41, 59, 0.8);
      backdrop-filter: blur(15px);
      border-radius: 16px;
      box-shadow: 0 0 20px rgba(255, 0, 0, 0.4), 0 0 60px rgba(255, 0, 0, 0.2);
      border: 1px solid rgba(255, 0, 0, 0.3);
      transition: box-shadow 0.3s ease, transform 0.3s ease;
    }

    .card:hover {
      transform: scale(1.02);
      box-shadow: 0 0 30px rgba(255, 0, 0, 0.5), 0 0 80px rgba(255, 0, 0, 0.3);
    }

    .form-input {
      background: rgba(15, 23, 42, 0.5);
      border: 1px solid #334155;
      transition: all 0.3s ease;
    }

    .form-input:focus {
      border-color: #f87171;
      box-shadow: 0 0 0 3px rgba(239, 68, 68, 0.4);
      background: rgba(15, 23, 42, 0.8);
    }

    .btn-primary {
      background: linear-gradient(135deg, #ef4444, #b91c1c);
      box-shadow: 0 4px 10px rgba(255, 0, 0, 0.3);
      transition: 0.3s;
    }

    .btn-primary:hover {
      background: linear-gradient(135deg, #dc2626, #7f1d1d);
      transform: translateY(-2px);
      box-shadow: 0 10px 20px rgba(255, 0, 0, 0.4);
    }

    .fade-in {
      opacity: 0;
      transform: translateY(10px);
    }

    .ripple-effect {
      position: absolute;
      border-radius: 50%;
      background: rgba(255, 255, 255, 0.2);
      transform: scale(0);
      animation: ripple 0.6s linear;
      pointer-events: none;
      width: 20px;
      height: 20px;
      margin-left: -10px;
      margin-top: -10px;
    }

    @keyframes ripple {
      to {
        transform: scale(10);
        opacity: 0;
      }
    }

    .glow-text {
      text-shadow: 0 0 10px #f87171, 0 0 20px #ef4444, 0 0 30px #b91c1c;
    }
  </style>
</head>

<body class="flex min-h-screen items-center justify-center p-4">
  <div class="card p-8 md:p-10 max-w-md w-full fade-in relative">
    <div class="text-center mb-8">
      <h2 class="text-3xl font-bold text-white mb-2 glow-text">GFX PANEL</h2>
      <p class="text-gray-400 text-sm">Login to continue your game service</p>
    </div>

    <form method="POST" action="/auth/login" class="space-y-5 fade-in" id="loginForm">
      <div>
        <label for="username" class="block text-sm text-gray-300 mb-1">Username or Email</label>
        <div class="relative">
          <input type="text" name="username" id="username" required autocomplete="username" placeholder="you@example.com"
            class="form-input w-full p-3 pl-10 rounded-lg text-white placeholder-gray-500 focus:outline-none">
          <i class="fas fa-user absolute left-3 top-3.5 text-gray-500"></i>
        </div>
      </div>

      <div>
        <label for="password" class="block text-sm text-gray-300 mb-1">Password</label>
        <div class="relative">
          <input type="password" name="password" id="password" required autocomplete="current-password"
            placeholder="••••••••"
            class="form-input w-full p-3 pl-10 pr-10 rounded-lg text-white placeholder-gray-500 focus:outline-none">
          <i class="fas fa-lock absolute left-3 top-3.5 text-gray-500"></i>
          <i class="fas fa-eye cursor-pointer text-gray-400 hover:text-white absolute right-3 top-3.5" id="togglePassword"></i>
        </div>
      </div>

      <div class="flex items-center justify-between text-sm">
        <label class="flex items-center text-gray-300">
          <input type="checkbox" class="mr-2 h-4 w-4 bg-gray-800 border-gray-700 text-red-600 focus:ring-red-500">
          Remember me
        </label>
        <a href="/forgot-password" class="text-red-400 hover:underline">Forgot password?</a>
      </div>

      <button type="submit"
        class="btn-primary w-full py-3 rounded-lg font-semibold flex items-center justify-center gap-2">
        <span>Sign In</span>
        <i class="fas fa-arrow-right"></i>
      </button>
    </form>
  </div>

  <script>
    document.addEventListener('DOMContentLoaded', () => {
      gsap.to(".fade-in", {
        opacity: 1,
        y: 0,
        duration: 0.8,
        stagger: 0.15,
        ease: "power2.out"
      });

      const loginForm = document.getElementById('loginForm');
      if (loginForm) {
        loginForm.addEventListener('submit', e => {
          const btn = loginForm.querySelector('button');
          gsap.to(btn, {
            scale: 0.95,
            duration: 0.2,
            yoyo: true,
            repeat: 1
          });
        });
      }

      document.querySelectorAll('button, a[href]').forEach(btn => {
        btn.addEventListener('click', e => {
          const x = e.clientX - btn.getBoundingClientRect().left;
          const y = e.clientY - btn.getBoundingClientRect().top;
          const ripple = document.createElement('span');
          ripple.className = 'ripple-effect';
          ripple.style.left = `${x}px`;
          ripple.style.top = `${y}px`;
          btn.appendChild(ripple);
          setTimeout(() => ripple.remove(), 600);
        });
      });

      // Password toggle
      const togglePassword = document.getElementById('togglePassword');
      const passwordInput = document.getElementById('password');
      togglePassword.addEventListener('click', () => {
        const type = passwordInput.getAttribute('type') === 'password' ? 'text' : 'password';
        passwordInput.setAttribute('type', type);
        togglePassword.classList.toggle('fa-eye');
        togglePassword.classList.toggle('fa-eye-slash');
      });
    });
  </script>
</body>
</html>
